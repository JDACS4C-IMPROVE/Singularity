Bootstrap: docker
From: tensorflow/tensorflow:latest-gpu

%labels
	MANTAINER Andreas Wilke
%setup
	# how are we going to specify this path
	cp ./src/Singularity_gpu_fix.sh $SINGULARITY_ROOTFS

%arguments
	tag=""

%environment
	IMPROVE_MODEL_DIR=/usr/local/Test
	PYTHONPATH=$PYTHONPATH:/usr/local/IMPROVE/

%post
	
	apt-get install -y wget
	apt-key adv --keyserver keyserver.ubuntu.com --recv-keys F60F4B3D7FA2AF80 {{ tag }}
	
	apt-get update
	apt-get install -y git vim

	chmod +x Singularity_gpu_fix.sh
	./Singularity_gpu_fix.sh
	rm Singularity_gpu_fix.sh
	which python

	mkdir -p /candle_data_dir

	# model respository
	cd /usr/local
	echo {{ tag }} >> /usr/local/hello.txt

%runscript
	cat /usr/local/hello.txt
